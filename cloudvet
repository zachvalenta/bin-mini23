#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
usage:
  cloudvet NAME                  create/show namespace
  cloudvet NAME start            record UTC start timestamp in context.toml
  cloudvet NAME stop             record UTC stop timestamp in context.toml
  cloudvet NAME agent SESSION_ID record agent session id in context.toml
  cloudvet NAME audit            query CloudTrail from start to stop
  cloudvet NAME status           show namespace state

storage:
  ${XDG_CONFIG_HOME:-$HOME/.config}/cloudvet/NAME

files:
  context.toml                   start/stop/session metadata
  MEMORABLE-SLUG.log             CloudTrail audit output

notes:
  - audit queries CloudTrail lookup-events across enabled AWS regions when possible
  - CloudTrail delivery can lag; wait a few minutes before audit for better coverage
  - AWS_PROFILE/AWS_REGION/AWS_DEFAULT_REGION are honored by awscli
EOF
}

fail() {
  echo "cloudvet: $*" >&2
  exit 1
}

utc_now() {
  date -u +"%Y-%m-%dT%H:%M:%SZ"
}

sanitize_name() {
  printf '%s' "$1" | tr -c 'A-Za-z0-9_.-' '_'
}

toml_escape() {
  local v
  v=$1
  v=${v//\\/\\\\}
  v=${v//"/\\"}
  printf '%s' "$v"
}

petname() {
  # Human-readable random slug; not intended for cryptographic uniqueness.
  local adjectives nouns a n
  adjectives="amber brave calm copper fuzzy gentle lucky maple quiet rapid silver tiny vivid wild"
  nouns="apple badger blackberry lantern otter racecar river sparrow tiger turtle walnut zeppelin orbit meadow"
  a=$(printf '%s\n' $adjectives | awk 'BEGIN{srand()} {w[NR]=$0} END{print w[int(rand()*NR)+1]}')
  n=$(printf '%s\n' $nouns | awk 'BEGIN{srand(systime()+1)} {w[NR]=$0} END{print w[int(rand()*NR)+1]}')
  printf '%s-%s' "$a" "$n"
}

base_dir() {
  printf '%s/cloudvet' "${XDG_CONFIG_HOME:-$HOME/.config}"
}

ns_dir() {
  local raw safe
  raw=$1
  safe=$(sanitize_name "$raw")
  printf '%s/%s' "$(base_dir)" "$safe"
}

context_path() {
  printf '%s/context.toml' "$1"
}

ensure_ns() {
  local name dir ctx
  name=$1
  dir=$(ns_dir "$name")
  ctx=$(context_path "$dir")
  mkdir -p "$dir"
  if [[ ! -f "$ctx" ]]; then
    cat > "$ctx" <<'EOF'
start = ""
stop = ""
session = ""
EOF
  fi
  printf '%s' "$dir"
}

get_context() {
  local dir key ctx
  dir=$1
  key=$2
  ctx=$(context_path "$dir")
  awk -F ' = ' -v key="$key" '$1 == key { gsub(/^"|"$/, "", $2); print $2; exit }' "$ctx"
}

write_context() {
  local dir start stop session ctx
  dir=$1
  start=$2
  stop=$3
  session=$4
  ctx=$(context_path "$dir")
  cat > "$ctx" <<EOF
start = "$(toml_escape "$start")"
stop = "$(toml_escape "$stop")"
session = "$(toml_escape "$session")"
EOF
}

set_context() {
  local dir key value start stop session
  dir=$1
  key=$2
  value=$3
  start=$(get_context "$dir" start || true)
  stop=$(get_context "$dir" stop || true)
  session=$(get_context "$dir" session || true)
  case "$key" in
    start) start=$value ;;
    stop) stop=$value ;;
    session) session=$value ;;
    *) fail "unknown context key: $key" ;;
  esac
  write_context "$dir" "$start" "$stop" "$session"
}

cmd_regions() {
  if command -v aws >/dev/null 2>&1; then
    aws ec2 describe-regions \
      --all-regions \
      --query 'Regions[?OptInStatus==`opt-in-not-required` || OptInStatus==`opted-in`].RegionName' \
      --output text 2>/dev/null | tr '\t' '\n' | awk 'NF' || true
  fi
  # If describe-regions failed or returned nothing, caller will use fallback.
}

show_status() {
  local dir start stop session
  dir=$1
  start=$(get_context "$dir" start || true)
  stop=$(get_context "$dir" stop || true)
  session=$(get_context "$dir" session || true)
  echo "namespace: $dir"
  [[ -n "$start" ]] && echo "start: $start" || echo "start: <unset>"
  [[ -n "$stop" ]] && echo "stop: $stop" || echo "stop: <unset>"
  [[ -n "$session" ]] && echo "session: $session" || echo "session: <unset>"
}

unique_log_path() {
  local dir slug out i
  dir=$1
  slug=$(petname)
  out="$dir/$slug.log"
  if [[ ! -e "$out" ]]; then
    printf '%s' "$out"
    return
  fi
  i=2
  while [[ -e "$dir/$slug-$i.log" ]]; do
    i=$((i + 1))
  done
  printf '%s' "$dir/$slug-$i.log"
}

[[ $# -ge 1 ]] || { usage; exit 2; }
[[ "$1" != "-h" && "$1" != "--help" ]] || { usage; exit 0; }

name=$1
cmd=${2:-}
dir=$(ensure_ns "$name")

case "$cmd" in
  "")
    show_status "$dir"
    ;;
  start)
    ts=$(utc_now)
    set_context "$dir" start "$ts"
    set_context "$dir" stop ""
    echo "$ts"
    ;;
  stop)
    ts=$(utc_now)
    set_context "$dir" stop "$ts"
    echo "$ts"
    ;;
  agent)
    [[ $# -eq 3 ]] || fail "agent requires SESSION_ID"
    session_id=$3
    [[ -n "$session_id" ]] || fail "empty SESSION_ID"
    set_context "$dir" session "$session_id"
    echo "$session_id"
    ;;
  audit)
    command -v aws >/dev/null 2>&1 || fail "aws cli not found"
    start=$(get_context "$dir" start || true)
    stop=$(get_context "$dir" stop || true)
    session=$(get_context "$dir" session || true)
    [[ -n "$start" ]] || fail "missing start; run: cloudvet $name start"
    [[ -n "$stop" ]] || fail "missing stop; run: cloudvet $name stop"
    out=$(unique_log_path "$dir")
    tmp_regions=$(mktemp)
    cmd_regions > "$tmp_regions"
    if [[ ! -s "$tmp_regions" ]]; then
      printf '%s\n' "${AWS_REGION:-${AWS_DEFAULT_REGION:-us-east-1}}" > "$tmp_regions"
    fi
    {
      echo "cloudvet audit"
      echo "namespace: $name"
      echo "created: $(utc_now)"
      echo "start: $start"
      echo "stop: $stop"
      echo "session: $session"
      echo
      echo "caller_identity:"
      aws sts get-caller-identity --output json || true
      echo
      echo "regions:"
      cat "$tmp_regions"
      echo
    } > "$out"

    while IFS= read -r region; do
      [[ -n "$region" ]] || continue
      {
        echo
        echo "## region: $region"
        aws cloudtrail lookup-events \
          --region "$region" \
          --start-time "$start" \
          --end-time "$stop" \
          --output json
      } >> "$out"
    done < "$tmp_regions"
    rm -f "$tmp_regions"
    echo "$out"
    ;;
  status)
    show_status "$dir"
    ;;
  -h|--help|help)
    usage
    ;;
  *)
    usage >&2
    exit 2
    ;;
esac
