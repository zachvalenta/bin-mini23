#!/usr/bin/env python

"""
Extract heading-based outline trees from Markdown files.

Usage:
    ext PATH... [--format=outline|tree|json] [--output=FILE] [--config=FILE]

Examples:
    ext note.md
    ext notes/ --format=tree
    ext notes/ --format=json --output=headings.json

Config:
    ext looks for JSON config in this order:
      1. --config=FILE
      2. .ext.json in the current directory or any parent
      3. ~/.config/ext/config.json

    Example config:
      {
        "ignore_heading_paths": [
          ["⛩️"],
          ["⛩️", "参考"],
          ["⛩️", "进步"]
        ],
        "ignore_mode": "subtree"
      }

    ignore_mode:
      - "subtree": ignore matched headings and all descendants
      - "node": ignore only matched heading nodes, keeping children
"""

import argparse
import json
import sys
from pathlib import Path
from markdown_it import MarkdownIt


DEFAULT_CONFIG = {
    "ignore_heading_paths": [],
    "ignore_mode": "subtree",
}


def load_config(config_path=None):
    candidates = []

    if config_path:
        candidates.append(Path(config_path).expanduser())
    else:
        cwd = Path.cwd()
        candidates.extend(parent / ".ext.json" for parent in [cwd, *cwd.parents])
        candidates.append(Path("~/.config/ext/config.json").expanduser())

    for path in candidates:
        if path.exists():
            with path.open() as f:
                user_config = json.load(f)
            config = DEFAULT_CONFIG.copy()
            config.update(user_config)
            config["ignore_heading_paths"] = [tuple(p) for p in config.get("ignore_heading_paths", [])]
            return config

    config = DEFAULT_CONFIG.copy()
    config["ignore_heading_paths"] = []
    return config


def heading_text(inline_token):
    if not inline_token.children:
        return inline_token.content.strip()
    return "".join(child.content for child in inline_token.children).strip()


def nest_headings(flat_headings):
    roots = []
    stack = []

    for heading in flat_headings:
        node = {"text": heading["text"], "level": heading["level"], "children": []}

        while stack and stack[-1]["level"] >= node["level"]:
            stack.pop()

        if stack:
            stack[-1]["children"].append(node)
        else:
            roots.append(node)

        stack.append(node)

    return roots


def filter_tree(nodes, ignored_paths, ignore_mode, ancestors=None):
    ancestors = ancestors or []
    filtered = []

    for node in nodes:
        path = tuple([*ancestors, node["text"]])
        ignored = path in ignored_paths

        if ignored and ignore_mode == "subtree":
            continue

        children = filter_tree(node["children"], ignored_paths, ignore_mode, path)

        if ignored and ignore_mode == "node":
            filtered.extend(children)
        else:
            new_node = dict(node)
            new_node["children"] = children
            filtered.append(new_node)

    return filtered


def extract_heading_tree(md_text, config):
    md = MarkdownIt()
    tokens = md.parse(md_text)
    headings = []

    for i, token in enumerate(tokens):
        if token.type != "heading_open":
            continue

        level = int(token.tag[1:])
        inline = tokens[i + 1] if i + 1 < len(tokens) and tokens[i + 1].type == "inline" else None
        text = heading_text(inline) if inline else ""
        headings.append({"text": text, "level": level})

    tree = nest_headings(headings)
    return filter_tree(tree, set(config["ignore_heading_paths"]), config["ignore_mode"])


def find_markdown_files(paths):
    files = []

    for path_str in paths:
        path = Path(path_str).expanduser()
        if not path.exists():
            print(f"File not found: {path}", file=sys.stderr)
            continue

        if path.is_file():
            if path.suffix.lower() in {".md", ".markdown", ".mdown"}:
                files.append(path)
            else:
                print(f"Skipping non-Markdown file: {path}", file=sys.stderr)
            continue

        files.extend(sorted(p for p in path.rglob("*") if p.is_file() and p.suffix.lower() in {".md", ".markdown", ".mdown"}))

    return sorted(dict.fromkeys(files), key=lambda p: str(p))


def file_records(files, config):
    records = []
    for path in files:
        md_text = path.read_text()
        records.append({
            "path": str(path),
            "headings": extract_heading_tree(md_text, config),
        })
    return records


def render_outline(nodes, depth=0):
    lines = []
    for node in nodes:
        lines.append(f"{'\t' * depth}{node['text']}")
        lines.extend(render_outline(node["children"], depth + 1))
    return lines


def render_tree_nodes(nodes, prefix=""):
    lines = []
    for i, node in enumerate(nodes):
        is_last = i == len(nodes) - 1
        branch = "└── " if is_last else "├── "
        child_prefix = prefix + ("    " if is_last else "│   ")
        lines.append(f"{prefix}{branch}{node['text']}")
        lines.extend(render_tree_nodes(node["children"], child_prefix))
    return lines


def render_tree(records):
    lines = []
    for file_i, record in enumerate(records):
        if file_i:
            lines.append("")
        lines.append(f"{Path(record['path']).name}")
        lines.extend(render_tree_nodes(record["headings"]))
    return "\n".join(lines)


def render_output(records, fmt):
    if fmt == "json":
        return json.dumps(records, ensure_ascii=False, indent=2)

    if fmt == "tree":
        return render_tree(records)

    chunks = []
    multi_file = len(records) > 1
    for record in records:
        if multi_file:
            chunks.append(record["path"])
        chunks.extend(render_outline(record["headings"]))
        if multi_file:
            chunks.append("")
    return "\n".join(chunks).rstrip()


def parse_args(argv):
    parser = argparse.ArgumentParser(description="Extract heading outlines from Markdown files.")
    parser.add_argument("paths", nargs="+", help="Markdown files or directories to scan recursively")
    parser.add_argument("--format", choices=["outline", "tree", "json"], default="outline")
    parser.add_argument("--output", help="Write output to file")
    parser.add_argument("--config", help="JSON config file")
    return parser.parse_args(argv)


def main(argv):
    args = parse_args(argv)
    config = load_config(args.config)
    files = find_markdown_files(args.paths)

    if not files:
        print("No Markdown files found.", file=sys.stderr)
        sys.exit(1)

    output = render_output(file_records(files, config), args.format)

    if args.output:
        Path(args.output).write_text(output)
    else:
        print(output)


if __name__ == "__main__":
    main(sys.argv[1:])
